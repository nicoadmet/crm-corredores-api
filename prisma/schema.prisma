generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  plan      String   @default("trial")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  properties Property[]
  leads Lead[]
  matches Match[]
  propertyImages PropertyImage[]
}

model User {
  id         String   @id @default(cuid())
  accountId  String
  supabaseId String   @unique
  email      String   @unique
  name       String
  role       String   @default("owner")
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
}

model Property {
  id             String    @id @default(cuid())
  accountId      String
  title          String
  operationType  String
  propertyType   String
  status         String    @default("disponible")
  price          Decimal
  currency       String    @default("USD")
  zone           String
  address        String?
  rooms          Int?
  bedrooms       Int?
  bathrooms      Int?
  garage         Boolean   @default(false)
  garageSpaces   Int?
  coveredArea    Float?
  totalArea      Float?
  floor          String?
  age            Int?
  description    String?
  ownerName      String?
  ownerPhone     String?
  ownerNotes     String?
  exclusive      Boolean   @default(false)
  exclusiveUntil DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id])
  matches Match[]
  images PropertyImage[]
}

model Lead {
  id               String    @id @default(cuid())
  accountId        String
  contactName      String
  contactPhone     String
  contactEmail     String?
  operationType    String
  propertyType     String
  zones            String[]
  budgetMin        Decimal?
  budgetMax        Decimal?
  minRooms         Int?
  minBathrooms     Int?
  needsGarage      Boolean?
  priority         String?
  nextFollowUpDate DateTime?
  status           String    @default("activo")
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id])
  matches Match[]
}

model Match {
  id         String   @id @default(cuid())
  accountId  String
  leadId     String
  propertyId String
  score      Int
  status     String   @default("sugerido")
  createdAt  DateTime @default(now())

  account  Account  @relation(fields: [accountId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([leadId, propertyId])
}

model PropertyImage {
  id           String   @id @default(cuid())
  accountId    String
  propertyId   String
  url          String
  thumbnailUrl String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  account  Account  @relation(fields: [accountId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
}
